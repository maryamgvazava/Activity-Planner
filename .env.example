# Server
PORT=3000

# --- Facebook ingestion (official Graph API only) ---
# Scraping Facebook's HTML directly is against Facebook's Terms of Service and
# is actively blocked by login walls / bot detection, so this project does not
# do that. Instead it uses the official Graph API against Pages/Groups you
# (the user) legitimately administer or otherwise have permission to read.
#
# 1. Create a Meta developer app: https://developers.facebook.com/apps
# 2. Generate a Page Access Token (or Group access, if you have an approved
#    Group API use case) with the appropriate `pages_read_engagement` /
#    equivalent permission.
# 3. Fill these in:
FB_ACCESS_TOKEN=
# Comma-separated list of Facebook Page IDs you have permission to read posts from
FB_PAGE_IDS=
# Comma-separated list of Facebook Group IDs (requires an approved Group API use case)
FB_GROUP_IDS=
# Graph API version to call
FB_GRAPH_VERSION=v19.0

# --- ss.ge / home.ge scraping ---
# Base listing URLs for the "land for sale" category. Update these if the
# site reorganizes its category URLs.
SSGE_LAND_URL=https://home.ss.ge/en/real-estate/l/Land-for-Sale
HOMEGE_LAND_URL=https://home.ge/land/for-sale
# How many listing pages to crawl per run
SCRAPE_MAX_PAGES=3
